universe        = vanilla
executable      = /bin/bash
arguments       = scripts/run_clean_lda_wrapper.sh $(year)

# Run jobs from the repo root (set this to your repo path)
initialdir      = /home/vrallapalli2/projects/lis501-frt-analysis

# IO paths on shared space (write under repo in /staging)
environment = "OUTPUT_ROOT=/staging/groups/lis501_fall2025/lis501-frt-analysis/years"

# Ship scripts + deps; corpus is read in place from OUTPUT_ROOT
transfer_input_files = scripts, python_libs.tar.gz

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# Outputs live on shared FS; nothing to pull back
transfer_output_files   =

log     = condor_logs/run_clean_lda_$(year)_$(Cluster).log
output  = condor_logs/run_clean_lda_$(year)_$(Cluster).out
error   = condor_logs/run_clean_lda_$(year)_$(Cluster).err
request_memory = 8GB
request_cpus   = 4
request_disk   = 30GB

queue year from (
2010
)

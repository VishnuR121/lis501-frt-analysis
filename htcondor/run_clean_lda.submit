universe        = vanilla
executable      = /bin/bash
arguments       = scripts/run_clean_lda_wrapper.sh $(year)

# Run jobs from the repo root (set this to your repo path)
initialdir      = /home/vrallapalli2/projects/lis501-frt-analysis

# Ship scripts + deps + yearly combined corpus (relative to initialdir)
transfer_input_files = \
  scripts, \
  python_libs.tar.gz, \
  years/$(year)/comments/corpus/corpus_threads_$(year).jsonl

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# Transfer the expected outputs; remap in case they are written flat
transfer_output_files   = years/$(year)/lda/topics.json, years/$(year)/lda/doc_topics.jsonl, topics.json, doc_topics.jsonl
transfer_output_remaps  = "topics.json=years/$(year)/lda/topics.json; doc_topics.jsonl=years/$(year)/lda/doc_topics.jsonl"

log     = condor_logs/run_clean_lda_$(year)_$(Cluster).log
output  = condor_logs/run_clean_lda_$(year)_$(Cluster).out
error   = condor_logs/run_clean_lda_$(year)_$(Cluster).err
request_memory = 8GB
request_cpus   = 4
request_disk   = 30GB

queue year from (
2008
)

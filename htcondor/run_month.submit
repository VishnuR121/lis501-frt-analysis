universe        = vanilla
executable      = scripts/run_month_pipeline.sh
arguments       = $(year) $(month)

# Ship only the scripts; the job reads raw comments from the shared path
# configured inside run_month_pipeline.sh.
transfer_input_files = scripts

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = years/$(year)/comments/threads, years/$(year)/comments/corpus

log     = condor_logs/run_month_$(Cluster)_$(Process).log
output  = condor_logs/run_month_$(Cluster)_$(Process).out
error   = condor_logs/run_month_$(Cluster)_$(Process).err

request_memory = 12GB
request_disk   = 30GB
request_cpus   = 1

# Fill in the months/years you want to process
queue year, month from (
2019 01
2019 02
2019 03
2019 04
2019 05
2019 06
2019 07
2019 08
2019 09
2019 10
2019 11
2019 12
)